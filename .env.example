# ---------------------------------------------------------------------------
# OKB Command Center - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# Application
APP_NAME="OKB Command Center"
NEXT_PUBLIC_APP_NAME="OKB Command Center"
NEXT_PUBLIC_APP_ENV=development

# Database (PostgreSQL + PostGIS)
# For Docker Compose the host is `db`; for local dev use `localhost`.
DATABASE_URL="postgresql://okb:okb_password@localhost:5432/okb_command_center?schema=public"

# Auth.js v5 (generate with: `npx auth secret` or `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Map / GIS
# MapLibre-compatible base style URL (used by the map feature in a later phase).
NEXT_PUBLIC_MAP_STYLE_URL="https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json"
# Optional tile/provider API key (server-side).
MAP_API_KEY=""
# Default map viewport (Philippines).
NEXT_PUBLIC_MAP_DEFAULT_LNG=121.7740
NEXT_PUBLIC_MAP_DEFAULT_LAT=12.8797
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=5.2

# Weather provider (server-side)
# Optional PAGASA TenDay API token from DOST-PAGASA (https://tenday.pagasa.dost.gov.ph).
# Live public feeds work without a token; this enables enriched 10-day municipal data.
WEATHER_API_KEY=""

# Upload storage driver: local | minio | s3
UPLOAD_STORAGE=local
UPLOAD_STORAGE_PATH="./public/uploads"

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Reports module (WhatsApp / Viber reports from the OKB Bridge) — SERVER ONLY
# Never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Supabase project used by okb-bridge-cloud-backend (okb_bridge_* tables).
OKB_BRIDGE_SUPABASE_URL=""
OKB_BRIDGE_SUPABASE_SERVICE_ROLE_KEY=""
# OKB Bridge REST API, used for operator review actions (approve / reject / reopen).
OKB_BRIDGE_API_URL=""          # e.g. https://okb-bridge-api.onrender.com
OKB_BRIDGE_ADMIN_TOKEN=""      # one of the bridge's OKB_ADMIN_TOKENS
# Shared operator access key for the Reports pages until a login provider exists.
# Use a long random value (e.g. `openssl rand -base64 32`).
OKB_REPORTS_ACCESS_KEY=""
# Development only (ignored in production builds): serve example fixture reports.
# OKB_REPORTS_DEV_FIXTURES=1
