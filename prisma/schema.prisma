/// Lookup: equipment category.
model EquipmentCategory {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  equipment Equipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

/// Lookup: equipment operational status.
model EquipmentStatus {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  color       String?
  isActive    Boolean @default(true)

  equipment Equipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

/// Named equipment location / depot (GIS Point).
model EquipmentLocation {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  geometry  Unsupported("geometry(Point, 4326)")?

  equipment Equipment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// A piece of response equipment (pump, backhoe, truck, ...).
model Equipment {
  id               String  @id @default(uuid()) @db.Uuid
  assetTag         String  @unique
  name             String
  model            String?
  serialNo         String?
  categoryId       String? @db.Uuid
  statusId         String? @db.Uuid
  currentLocationId String? @db.Uuid
  districtOfficeId String? @db.Uuid

  category        EquipmentCategory?         @relation(fields: [categoryId], references: [id])
  status          EquipmentStatus?           @relation(fields: [statusId], references: [id])
  currentLocation EquipmentLocation?         @relation(fields: [currentLocationId], references: [id])
  districtOffice  DistrictEngineeringOffice? @relation(fields: [districtOfficeId], references: [id])

  assignments  EquipmentAssignment[]
  maintenance  EquipmentMaintenance[]
  gpsHistory   GpsHistory[]
  dispatches   EmergencyDispatch[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([categoryId])
  @@index([statusId])
  @@index([currentLocationId])
  @@index([districtOfficeId])
  @@index([deletedAt])
}

/// Assignment of equipment to a user / office for a period.
model EquipmentAssignment {
  id           String           @id @default(uuid()) @db.Uuid
  equipmentId  String           @db.Uuid
  assignedToId String?          @db.Uuid
  status       AssignmentStatus @default(ACTIVE)
  purpose      String?
  assignedAt   DateTime         @default(now())
  returnedAt   DateTime?

  equipment  Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation(fields: [assignedToId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([equipmentId])
  @@index([assignedToId])
  @@index([status])
}

/// Maintenance record for equipment.
model EquipmentMaintenance {
  id          String          @id @default(uuid()) @db.Uuid
  equipmentId String          @db.Uuid
  type        MaintenanceType @default(PREVENTIVE)
  description String?
  cost        Decimal?        @db.Decimal(12, 2)
  performedAt DateTime        @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([equipmentId])
  @@index([performedAt])
}

/// Append-only GPS breadcrumb for equipment (GIS Point time-series).
model GpsHistory {
  id          String   @id @default(uuid()) @db.Uuid
  equipmentId String   @db.Uuid
  latitude    Float
  longitude   Float
  speedKph    Float?
  heading     Float?
  recordedAt  DateTime @default(now())
  geometry    Unsupported("geometry(Point, 4326)")?

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([equipmentId, recordedAt])
  @@index([geometry], type: Gist)
}

// =============================================================================
// WEATHER
// =============================================================================

/// Weather station (GIS Point).
model WeatherStation {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique
  name      String
  cityId    String? @db.Uuid
  elevationM Float?
  latitude  Float?
  longitude Float?
  geometry  Unsupported("geometry(Point, 4326)")?

  city         City?          @relation(fields: [cityId], references: [id])
  rainfallData RainfallData[]
  forecasts    Forecast[]
  sensors      Sensor[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([cityId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// Append-only rainfall reading from a weather station.
model RainfallData {
  id         String   @id @default(uuid()) @db.Uuid
  stationId  String   @db.Uuid
  amountMm   Float
  intervalMin Int      @default(60)
  recordedAt DateTime @default(now())

  station WeatherStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([stationId, recordedAt])
}

/// Weather forecast entry for a station.
model Forecast {
  id             String   @id @default(uuid()) @db.Uuid
  stationId      String?  @db.Uuid
  forecastFor    DateTime
  temperatureC   Float?
  rainfallMm     Float?
  humidityPct    Float?
  windSpeedKph   Float?
  summary        String?
  source         String?

  station WeatherStation? @relation(fields: [stationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([stationId])
  @@index([forecastFor])
}

/// Weather advisory / alert (optionally region-scoped, GIS area).
model WeatherAlert {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  description String?
  severity    AlertSeverity @default(ADVISORY)
  regionId    String?       @db.Uuid
  effectiveAt DateTime      @default(now())
  expiresAt   DateTime?
  geometry    Unsupported("geometry(MultiPolygon, 4326)")?

  region Region? @relation(fields: [regionId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([regionId])
  @@index([severity])
  @@index([effectiveAt])
  @@index([geometry], type: Gist)
}

/// Weather radar coverage metadata (future radar integration; GIS area).
model RadarMetadata {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  provider   String?
  rangeKm    Float?
  latitude   Float?
  longitude  Float?
  coverage   Unsupported("geometry(Polygon, 4326)")?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([deletedAt])
  @@index([coverage], type: Gist)
}

// =============================================================================
// REPORTS
// =============================================================================

/// Registry of generated report files (links reports to stored files).
model GeneratedFile {
  id       String       @id @default(uuid()) @db.Uuid
  fileId   String       @db.Uuid
  format   String?
  status   ReportStatus @default(COMPLETED)

  file File @relation(fields: [fileId], references: [id])

  dailyReport   DailyReport?
  weeklyReport  WeeklyReport?
  monthlyReport MonthlyReport?
  annualReport  AnnualReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([fileId])
}

/// Daily operational report.
model DailyReport {
  id              String       @id @default(uuid()) @db.Uuid
  title           String
  reportDate      DateTime
  status          ReportStatus @default(DRAFT)
  summary         String?
  generatedFileId String?      @unique @db.Uuid

  generatedFile GeneratedFile? @relation(fields: [generatedFileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([reportDate])
  @@index([status])
}

/// Weekly operational report.
model WeeklyReport {
  id              String       @id @default(uuid()) @db.Uuid
  title           String
  year            Int
  week            Int
  status          ReportStatus @default(DRAFT)
  summary         String?
  generatedFileId String?      @unique @db.Uuid

  generatedFile GeneratedFile? @relation(fields: [generatedFileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@unique([year, week])
  @@index([status])
}

/// Monthly operational report.
model MonthlyReport {
  id              String       @id @default(uuid()) @db.Uuid
  title           String
  year            Int
  month           Int
  status          ReportStatus @default(DRAFT)
  summary         String?
  generatedFileId String?      @unique @db.Uuid

  generatedFile GeneratedFile? @relation(fields: [generatedFileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@unique([year, month])
  @@index([status])
}

/// Annual operational report.
model AnnualReport {
  id              String       @id @default(uuid()) @db.Uuid
  title           String
  year            Int          @unique
  status          ReportStatus @default(DRAFT)
  summary         String?
  generatedFileId String?      @unique @db.Uuid

  generatedFile GeneratedFile? @relation(fields: [generatedFileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([status])
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

/// Reusable notification template.
model NotificationTemplate {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique
  name         String
  subject      String?
  bodyTemplate String
  isActive     Boolean @default(true)

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

/// A dispatched notification (fan-out to recipients + delivery logs).
model Notification {
  id         String               @id @default(uuid()) @db.Uuid
  templateId String?              @db.Uuid
  title      String
  body       String
  priority   NotificationPriority @default(NORMAL)

  template   NotificationTemplate? @relation(fields: [templateId], references: [id])
  recipients NotificationRecipient[]
  logs       NotificationLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([templateId])
  @@index([priority])
}

/// Junction: notification ↔ recipient user (with per-user read state).
model NotificationRecipient {
  id             String    @id @default(uuid()) @db.Uuid
  notificationId String    @db.Uuid
  userId         String    @db.Uuid
  readAt         DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@unique([notificationId, userId])
  @@index([userId])
}

/// Append-only per-channel delivery log for a notification.
model NotificationLog {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  detail         String?
  sentAt         DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([notificationId])
  @@index([status])
}

// =============================================================================
// ATTACHMENTS (single file registry + one-to-one type detail)
// =============================================================================

/// Canonical stored file. Media-specific metadata lives in Image/Video/Document.
model File {
  id           String        @id @default(uuid()) @db.Uuid
  kind         FileKind      @default(OTHER)
  storage      StorageDriver @default(LOCAL)
  bucket       String?
  path         String
  originalName String
  mimeType     String
  sizeBytes    BigInt
  checksum     String?

  image    Image?
  video    Video?
  document Document?

  users               User[]
  floodIncidentPhotos FloodIncidentPhoto[]
  floodIncidentVideos FloodIncidentVideo[]
  criticalAreaPhotos  CriticalAreaPhoto[]
  projectPhotos       ProjectPhoto[]
  projectDocuments    ProjectDocument[]
  generatedFiles      GeneratedFile[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([kind])
  @@index([deletedAt])
}

/// Image-specific metadata (one-to-one with File).
model Image {
  id       String @id @default(uuid()) @db.Uuid
  fileId   String @unique @db.Uuid
  width    Int?
  height   Int?
  altText  String?

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

/// Video-specific metadata (one-to-one with File).
model Video {
  id         String @id @default(uuid()) @db.Uuid
  fileId     String @unique @db.Uuid
  durationSec Int?
  width      Int?
  height     Int?

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

/// Document-specific metadata (one-to-one with File).
model Document {
  id        String @id @default(uuid()) @db.Uuid
  fileId    String @unique @db.Uuid
  pageCount Int?

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

// =============================================================================
// AUDIT & OBSERVABILITY (append-only)
// =============================================================================

/// Entity change audit trail.
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @db.Uuid
  action     AuditAction
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

/// System / application log entry.
model SystemLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     LogLevel @default(INFO)
  source    String?
  message   String
  context   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([createdAt])
}

/// User login attempt history.
model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  email     String?
  success   Boolean  @default(false)
  ipAddress String?
  userAgent String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

/// User activity feed (append-only).
model ActivityLog {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String? @db.Uuid
  action     String
  entityType String?
  entityId   String?
  metadata   Json?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

// =============================================================================
// FUTURE EXPANSION (CCTV / IoT sensors / AI / emergency ops)
// =============================================================================

/// CCTV camera (GIS Point).
model Cctv {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique
  name      String
  streamUrl String?
  status    CctvStatus @default(OFFLINE)
  cityId    String?    @db.Uuid
  latitude  Float?
  longitude Float?
  geometry  Unsupported("geometry(Point, 4326)")?

  city City? @relation(fields: [cityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([cityId])
  @@index([status])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// IoT sensor (GIS Point).
model Sensor {
  id         String       @id @default(uuid()) @db.Uuid
  code       String       @unique
  name       String
  type       SensorType
  status     SensorStatus @default(OFFLINE)
  unit       String?
  cityId     String?      @db.Uuid
  stationId  String?      @db.Uuid
  latitude   Float?
  longitude  Float?
  geometry   Unsupported("geometry(Point, 4326)")?

  city    City?           @relation(fields: [cityId], references: [id])
  station WeatherStation? @relation(fields: [stationId], references: [id])

  readings          SensorReading[]
  waterLevelReadings WaterLevelReading[]
  riverLevels       RiverLevel[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([type])
  @@index([status])
  @@index([cityId])
  @@index([stationId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// Append-only generic sensor reading (time-series).
model SensorReading {
  id         String   @id @default(uuid()) @db.Uuid
  sensorId   String   @db.Uuid
  value      Float
  unit       String?
  quality    String?
  recordedAt DateTime @default(now())

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sensorId, recordedAt])
}

/// Append-only river-level reading (time-series; tied to a waterway/sensor).
model RiverLevel {
  id         String   @id @default(uuid()) @db.Uuid
  waterwayId String?  @db.Uuid
  sensorId   String?  @db.Uuid
  levelM     Float
  trend      String?
  recordedAt DateTime @default(now())

  waterway Waterway? @relation(fields: [waterwayId], references: [id])
  sensor   Sensor?   @relation(fields: [sensorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([waterwayId, recordedAt])
  @@index([sensorId, recordedAt])
}

/// Append-only water-level reading (time-series; tied to a sensor).
model WaterLevelReading {
  id         String   @id @default(uuid()) @db.Uuid
  sensorId   String   @db.Uuid
  levelM     Float
  alarmLevel Float?
  recordedAt DateTime @default(now())

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sensorId, recordedAt])
}

/// Drone survey flight (GIS LineString path).
model DroneFlight {
  id         String            @id @default(uuid()) @db.Uuid
  reference  String            @unique
  pilotId    String?           @db.Uuid
  cityId     String?           @db.Uuid
  status     DroneFlightStatus @default(PLANNED)
  startedAt  DateTime?
  endedAt    DateTime?
  path       Unsupported("geometry(LineString, 4326)")?

  pilot User? @relation(fields: [pilotId], references: [id])
  city  City? @relation(fields: [cityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([pilotId])
  @@index([cityId])
  @@index([status])
  @@index([path], type: Gist)
}

/// AI analysis output linked to a flood incident.
model AiAnalysis {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String?  @db.Uuid
  model      String
  confidence Float?
  result     Json?
  analyzedAt DateTime @default(now())

  incident FloodIncident? @relation(fields: [incidentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([incidentId])
  @@index([analyzedAt])
}

/// AI / model prediction (flood, rainfall, river level, ...); optional GIS area.
model Prediction {
  id          String         @id @default(uuid()) @db.Uuid
  type        PredictionType
  regionId    String?        @db.Uuid
  probability Float?
  validFrom   DateTime
  validTo     DateTime?
  payload     Json?
  geometry    Unsupported("geometry(MultiPolygon, 4326)")?

  region Region? @relation(fields: [regionId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([type])
  @@index([regionId])
  @@index([validFrom])
  @@index([geometry], type: Gist)
}

/// Emergency dispatch of equipment/personnel to a flood incident.
model EmergencyDispatch {
  id          String         @id @default(uuid()) @db.Uuid
  reference   String         @unique
  incidentId  String?        @db.Uuid
  equipmentId String?        @db.Uuid
  commanderId String?        @db.Uuid
  status      DispatchStatus @default(REQUESTED)
  notes       String?
  dispatchedAt DateTime?
  arrivedAt   DateTime?
  completedAt DateTime?

  incident  FloodIncident? @relation(fields: [incidentId], references: [id])
  equipment Equipment?     @relation(fields: [equipmentId], references: [id])
  commander User?          @relation(fields: [commanderId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([incidentId])
  @@index([equipmentId])
  @@index([commanderId])
  @@index([status])
}

/// Road closure event (tied to a road; GIS LineString of the closed section).
model RoadClosure {
  id        String            @id @default(uuid()) @db.Uuid
  roadId    String            @db.Uuid
  status    RoadClosureStatus @default(CLOSED)
  reason    String?
  startedAt DateTime          @default(now())
  clearedAt DateTime?
  geometry  Unsupported("geometry(LineString, 4326)")?

  road Road @relation(fields: [roadId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([roadId])
  @@index([status])
  @@index([geometry], type: Gist)
}

/// Evacuation center (GIS Point).
model EvacuationCenter {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  capacity    Int?
  contactInfo String?
  isOperational Boolean @default(true)
  barangayId  String? @db.Uuid
  latitude    Float?
  longitude   Float?
  geometry    Unsupported("geometry(Point, 4326)")?

  barangay Barangay? @relation(fields: [barangayId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([barangayId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}
