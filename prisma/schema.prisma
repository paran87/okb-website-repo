// =============================================================================
// OKB Command Center — Production Database Schema
// DPWH · Oplan Kontra Baha (Flood Control) — nationwide GIS operations platform
//
// Conventions
// -----------
// * Primary keys: UUID v4 (`@db.Uuid`, `@default(uuid())`).
// * Timestamps: `createdAt`, `updatedAt` on every table; `deletedAt` (soft
//   delete) on mutable domain entities. Append-only tables (readings, logs,
//   history, junctions) omit `deletedAt`.
// * `createdBy` / `updatedBy` are UUID audit stamps referencing `User.id`.
//   Referential integrity for these stamps is enforced at the application layer
//   to avoid ~160 back-relations on `User`. Semantically important actors
//   (reporter, inspector, pilot, commander, recipient) use real relations.
// * GIS: geometry columns use PostGIS `geometry(<Type>, 4326)` (WGS84) with GiST
//   spatial indexes. Columns are nullable so rows can be created before geometry
//   is populated by spatial pipelines.
// * Extensible catalogs are lookup tables; fixed, code-level sets are enums.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum FileKind {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum StorageDriver {
  LOCAL
  MINIO
  S3
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  APPROVE
  REJECT
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  CALIBRATION
}

enum InspectionResult {
  PASSED
  FAILED
  NEEDS_ATTENTION
}

enum AlertSeverity {
  INFO
  ADVISORY
  WATCH
  WARNING
  EMERGENCY
}

enum SensorType {
  WATER_LEVEL
  RAINFALL
  RIVER_GAUGE
  FLOW
  WEATHER
  SOIL_MOISTURE
}

enum SensorStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  FAULT
  DECOMMISSIONED
}

enum CctvStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  DECOMMISSIONED
}

enum DispatchStatus {
  REQUESTED
  DISPATCHED
  EN_ROUTE
  ON_SITE
  COMPLETED
  CANCELLED
}

enum RoadClosureStatus {
  OPEN
  PARTIAL
  CLOSED
}

enum DroneFlightStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum PredictionType {
  FLOOD
  RAINFALL
  RIVER_LEVEL
  LANDSLIDE
}

enum ReportStatus {
  DRAFT
  GENERATING
  COMPLETED
  PUBLISHED
  ARCHIVED
  FAILED
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
  OVERDUE
  CANCELLED
}

// =============================================================================
// AUTHENTICATION & RBAC
// =============================================================================

/// System users (operators, engineers, directors, administrators).
model User {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @unique
  emailVerified DateTime?
  name          String
  passwordHash  String?
  phone         String?
  avatarFileId  String?           @db.Uuid
  status        UserAccountStatus @default(PENDING)
  lastLoginAt   DateTime?

  roleId           String  @db.Uuid
  regionId         String? @db.Uuid
  districtOfficeId String? @db.Uuid

  role          Role                     @relation(fields: [roleId], references: [id])
  region        Region?                  @relation(fields: [regionId], references: [id])
  districtOffice DistrictEngineeringOffice? @relation(fields: [districtOfficeId], references: [id])
  avatar        File?                    @relation(fields: [avatarFileId], references: [id])

  accounts                Account[]
  sessions                Session[]
  reportedIncidents       FloodIncident[]
  floodResponses          FloodResponse[]
  criticalAreaInspections CriticalAreaInspection[]
  equipmentAssignments    EquipmentAssignment[]
  droneFlights            DroneFlight[]
  dispatchesCommanded     EmergencyDispatch[]
  notificationRecipients  NotificationRecipient[]
  loginHistory            LoginHistory[]
  activityLogs            ActivityLog[]
  auditLogs               AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([roleId])
  @@index([regionId])
  @@index([districtOfficeId])
  @@index([status])
  @@index([deletedAt])
}

/// RBAC role (dynamic; mapped to permissions via RolePermission).
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  users       User[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
}

/// Fine-grained permission expressed as resource:action.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  resource    String
  action      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([resource])
}

/// Junction: roles ↔ permissions (many-to-many).
model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

/// Auth.js OAuth / external account link.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js session.
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([userId])
}

/// Auth.js verification token (email verification / passwordless).
model VerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  token      String   @unique
  expires    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identifier, token])
}

// =============================================================================
// ORGANIZATION (DPWH administrative hierarchy + physical assets)
// =============================================================================

/// DPWH Region (top-level administrative unit).
model Region {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  geometry Unsupported("geometry(MultiPolygon, 4326)")?

  districtOffices DistrictEngineeringOffice[]
  cities          City[]
  users           User[]
  weatherAlerts   WeatherAlert[]
  predictions     Prediction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// District Engineering Office (operational unit within a region).
model DistrictEngineeringOffice {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique
  name      String
  address   String?
  regionId  String  @db.Uuid
  latitude  Float?
  longitude Float?
  geometry  Unsupported("geometry(Point, 4326)")?

  region         Region          @relation(fields: [regionId], references: [id])
  users          User[]
  projects       Project[]
  equipment      Equipment[]
  floodIncidents FloodIncident[]
  roads          Road[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([regionId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// City / Municipality.
model City {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  regionId String  @db.Uuid
  geometry Unsupported("geometry(MultiPolygon, 4326)")?

  region          Region           @relation(fields: [regionId], references: [id])
  barangays       Barangay[]
  roads           Road[]
  waterways       Waterway[]
  drainageSystems DrainageSystem[]
  pumpStations    PumpStation[]
  criticalAreas   CriticalArea[]
  floodProneAreas FloodProneArea[]
  projects        Project[]
  weatherStations WeatherStation[]
  cctvs           Cctv[]
  sensors         Sensor[]
  droneFlights    DroneFlight[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([regionId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// Barangay (smallest administrative unit).
model Barangay {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  cityId   String  @db.Uuid
  geometry Unsupported("geometry(MultiPolygon, 4326)")?

  city              City               @relation(fields: [cityId], references: [id])
  floodIncidents    FloodIncident[]
  evacuationCenters EvacuationCenter[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([cityId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// Road network segment (GIS LineString).
model Road {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  classification String?
  lengthKm       Float?
  cityId         String? @db.Uuid
  districtOfficeId String? @db.Uuid
  geometry       Unsupported("geometry(LineString, 4326)")?

  city          City?                      @relation(fields: [cityId], references: [id])
  districtOffice DistrictEngineeringOffice? @relation(fields: [districtOfficeId], references: [id])
  closures      RoadClosure[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([cityId])
  @@index([districtOfficeId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// Waterway / river / creek (GIS LineString).
model Waterway {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  type     String?
  cityId   String? @db.Uuid
  geometry Unsupported("geometry(LineString, 4326)")?

  city        City?        @relation(fields: [cityId], references: [id])
  riverLevels RiverLevel[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([cityId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// Drainage system / canal (GIS LineString).
model DrainageSystem {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  type     String?
  capacity Float?
  cityId   String? @db.Uuid
  geometry Unsupported("geometry(LineString, 4326)")?

  city City? @relation(fields: [cityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([cityId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// Flood-control pump station (GIS Point).
model PumpStation {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  capacityLps Float?
  pumpCount   Int?
  isOperational Boolean @default(true)
  cityId      String? @db.Uuid
  latitude    Float?
  longitude   Float?
  geometry    Unsupported("geometry(Point, 4326)")?

  city City? @relation(fields: [cityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([cityId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

// =============================================================================
// FLOOD MONITORING
// =============================================================================

/// Lookup: operational status of a flood incident.
model FloodStatus {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  color       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  incidents FloodIncident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

/// Lookup: severity classification of a flood incident.
model FloodSeverity {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  color       String?
  level       Int     @default(0)
  isActive    Boolean @default(true)

  incidents FloodIncident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

/// Lookup: root cause of flooding.
model FloodCause {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  incidents FloodIncident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

/// A reported/observed flood event (operational core; GIS Point).
model FloodIncident {
  id               String    @id @default(uuid()) @db.Uuid
  referenceNo      String    @unique
  title            String
  description      String?
  waterLevelM      Float?
  affectedFamilies Int?
  reportedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  latitude         Float?
  longitude        Float?
  geometry         Unsupported("geometry(Point, 4326)")?

  statusId         String  @db.Uuid
  severityId       String  @db.Uuid
  causeId          String? @db.Uuid
  barangayId       String? @db.Uuid
  districtOfficeId String? @db.Uuid
  reportedById     String? @db.Uuid

  status         FloodStatus                @relation(fields: [statusId], references: [id])
  severity       FloodSeverity              @relation(fields: [severityId], references: [id])
  cause          FloodCause?                @relation(fields: [causeId], references: [id])
  barangay       Barangay?                  @relation(fields: [barangayId], references: [id])
  districtOffice DistrictEngineeringOffice? @relation(fields: [districtOfficeId], references: [id])
  reportedBy     User?                      @relation(fields: [reportedById], references: [id])

  photos    FloodIncidentPhoto[]
  videos    FloodIncidentVideo[]
  history   FloodHistory[]
  responses FloodResponse[]
  dispatches EmergencyDispatch[]
  aiAnalyses AiAnalysis[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([statusId])
  @@index([severityId])
  @@index([causeId])
  @@index([barangayId])
  @@index([districtOfficeId])
  @@index([reportedById])
  @@index([reportedAt])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// Photo attached to a flood incident.
model FloodIncidentPhoto {
  id         String  @id @default(uuid()) @db.Uuid
  incidentId String  @db.Uuid
  fileId     String  @db.Uuid
  caption    String?

  incident FloodIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  file     File          @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([incidentId])
  @@index([fileId])
}

/// Video attached to a flood incident.
model FloodIncidentVideo {
  id         String  @id @default(uuid()) @db.Uuid
  incidentId String  @db.Uuid
  fileId     String  @db.Uuid
  caption    String?

  incident FloodIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  file     File          @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([incidentId])
  @@index([fileId])
}

/// Append-only state timeline for a flood incident.
model FloodHistory {
  id           String  @id @default(uuid()) @db.Uuid
  incidentId   String  @db.Uuid
  statusCode   String?
  waterLevelM  Float?
  note         String?
  recordedAt   DateTime @default(now())

  incident FloodIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([incidentId])
  @@index([recordedAt])
}

/// Response action taken for a flood incident.
model FloodResponse {
  id          String    @id @default(uuid()) @db.Uuid
  incidentId  String    @db.Uuid
  responderId String?   @db.Uuid
  action      String
  details     String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  incident  FloodIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  responder User?         @relation(fields: [responderId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([incidentId])
  @@index([responderId])
}

// =============================================================================
// CRITICAL AREAS
// =============================================================================

/// A monitored high-risk critical area (GIS Polygon).
model CriticalArea {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  riskLevelId String? @db.Uuid
  cityId      String? @db.Uuid
  geometry    Unsupported("geometry(Polygon, 4326)")?

  riskLevel   FloodRiskLevel? @relation(fields: [riskLevelId], references: [id])
  city        City?           @relation(fields: [cityId], references: [id])
  inspections CriticalAreaInspection[]
  photos      CriticalAreaPhoto[]
  history     CriticalAreaHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([riskLevelId])
  @@index([cityId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// Inspection record for a critical area.
model CriticalAreaInspection {
  id            String           @id @default(uuid()) @db.Uuid
  criticalAreaId String          @db.Uuid
  inspectorId   String?          @db.Uuid
  result        InspectionResult @default(NEEDS_ATTENTION)
  findings      String?
  inspectedAt   DateTime         @default(now())

  criticalArea CriticalArea @relation(fields: [criticalAreaId], references: [id], onDelete: Cascade)
  inspector    User?        @relation(fields: [inspectorId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([criticalAreaId])
  @@index([inspectorId])
  @@index([inspectedAt])
}

/// Photo attached to a critical area.
model CriticalAreaPhoto {
  id             String  @id @default(uuid()) @db.Uuid
  criticalAreaId String  @db.Uuid
  fileId         String  @db.Uuid
  caption        String?

  criticalArea CriticalArea @relation(fields: [criticalAreaId], references: [id], onDelete: Cascade)
  file         File         @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([criticalAreaId])
  @@index([fileId])
}

/// Append-only history for a critical area.
model CriticalAreaHistory {
  id             String   @id @default(uuid()) @db.Uuid
  criticalAreaId String   @db.Uuid
  change         String
  note           String?
  recordedAt     DateTime @default(now())

  criticalArea CriticalArea @relation(fields: [criticalAreaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([criticalAreaId])
  @@index([recordedAt])
}

// =============================================================================
// FLOOD-PRONE AREAS
// =============================================================================

/// Lookup: flood risk level (shared by critical + flood-prone areas).
model FloodRiskLevel {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  color       String?
  level       Int     @default(0)
  isActive    Boolean @default(true)

  criticalAreas   CriticalArea[]
  floodProneAreas FloodProneArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

/// Lookup: historical flood frequency classification.
model FloodFrequency {
  id            String  @id @default(uuid()) @db.Uuid
  code          String  @unique
  name          String
  description   String?
  returnPeriodY Int?
  isActive      Boolean @default(true)

  floodProneAreas FloodProneArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

/// A delineated flood-prone / flood-susceptible area (GIS MultiPolygon).
model FloodProneArea {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  riskLevelId String? @db.Uuid
  frequencyId String? @db.Uuid
  cityId      String? @db.Uuid
  areaSqKm    Float?
  geometry    Unsupported("geometry(MultiPolygon, 4326)")?

  riskLevel   FloodRiskLevel? @relation(fields: [riskLevelId], references: [id])
  frequency   FloodFrequency? @relation(fields: [frequencyId], references: [id])
  city        City?           @relation(fields: [cityId], references: [id])
  mitigations FloodProneAreaMitigation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([riskLevelId])
  @@index([frequencyId])
  @@index([cityId])
  @@index([deletedAt])
  @@index([geometry], type: Gist)
}

/// Catalog of mitigation measures.
model FloodMitigationMeasure {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  areaMitigations FloodProneAreaMitigation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
}

/// Junction: flood-prone area ↔ mitigation measure (with status/cost).
model FloodProneAreaMitigation {
  id               String    @id @default(uuid()) @db.Uuid
  floodProneAreaId String    @db.Uuid
  measureId        String    @db.Uuid
  status           String?
  estimatedCost    Decimal?  @db.Decimal(14, 2)
  implementedAt    DateTime?

  floodProneArea FloodProneArea         @relation(fields: [floodProneAreaId], references: [id], onDelete: Cascade)
  measure        FloodMitigationMeasure @relation(fields: [measureId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@unique([floodProneAreaId, measureId])
  @@index([measureId])
}

